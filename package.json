{
  "name": "keyskin",
  "private": true,
  "version": "2.0.0-beta6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test",
    "deploy:cloudbase": "tcb app deploy",
    "version:feature": "node scripts/bump-version.mjs feature",
    "version:bugfix": "node scripts/bump-version.mjs bugfix",
    "tauri": "node scripts/tauri.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "for f in scripts/test-*.mjs; do echo \"== $f\"; node \"$f\" || exit 1; done",
    "test:ui": "node scripts/ui-snapshot.mjs compare"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@earendil-works/pi-agent-core": "^0.84.4",
    "@earendil-works/pi-ai": "^0.84.4",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.3",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@wasm-audio-decoders/ogg-vorbis": "^0.1.20",
    "deep-chat": "^2.5.1",
    "fflate": "^0.8.2",
    "lucide": "^1.45.0",
    "wasm-media-encoders": "^0.7.0"
  },
  "devDependencies": {
    "@cloudbase/cli": "^3.8.1",
    "@tauri-apps/cli": "^2.8.0",
    "playwright": "^1.56.1",
    "postcss": "^8.5.24",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}

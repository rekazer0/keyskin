{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "默认桌面窗口权限",
  "windows": ["main", "image-picker", "resource-picker", "new-project"],
  "permissions": [
    "core:default",
    "core:window:allow-create",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-destroy",
    "core:window:allow-set-focus",
    "core:webview:allow-create-webview-window",
    "core:window:allow-start-dragging",
    "core:window:allow-set-theme",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-watch",
    "fs:allow-unwatch",
    "native-share:allow-pickSourceDirectory",
    "native-share:allow-chooseProjectTemplate",
    "native-share:allow-createSourceWorkspace",
    "native-share:allow-readSourceWorkspace",
    "native-share:allow-applySourceChanges",
    "native-share:allow-startSourceObserver",
    "native-share:allow-stopSourceObserver"
  ]
}

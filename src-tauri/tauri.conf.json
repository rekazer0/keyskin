{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "键设 KeySkin",
  "version": "2.0.0-beta6",
  "identifier": "io.github.rekazer0.keyskin",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https: http://127.0.0.1:* http://localhost:*; img-src 'self' blob: data:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'"
    },
    "windows": [
      {
        "title": "键设 KeySkin v2.0.0-beta6",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "transparent": true,
        "backgroundColor": [0, 0, 0, 0],
        "windowEffects": {
          "effects": ["sidebar"]
        }
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "百度、搜狗与手心输入法皮肤可视化编辑器",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "fileAssociations": [
      {
        "ext": ["bdi"],
        "name": "百度输入法 iOS 皮肤",
        "mimeType": "application/octet-stream",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": {
          "identifier": "io.github.rekazer0.keyskin.bdi",
          "conformsTo": ["public.data"]
        }
      },
      {
        "ext": ["bds"],
        "name": "百度输入法 Android 皮肤",
        "mimeType": "application/octet-stream",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": {
          "identifier": "io.github.rekazer0.keyskin.bds",
          "conformsTo": ["public.data"]
        }
      },
      {
        "ext": ["bda"],
        "name": "百度输入法新版 Android 皮肤",
        "mimeType": "application/octet-stream",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": {
          "identifier": "io.github.rekazer0.keyskin.bda",
          "conformsTo": ["public.data"]
        }
      },
      {
        "ext": ["ssf", "mssf"],
        "name": "搜狗输入法皮肤",
        "mimeType": "application/octet-stream",
        "role": "Editor",
        "rank": "Alternate",
        "exportedType": {
          "identifier": "io.github.rekazer0.keyskin.ssf",
          "conformsTo": ["public.data"]
        }
      },
      {
        "ext": ["sxi"],
        "name": "手心输入法皮肤",
        "mimeType": "application/octet-stream",
        "role": "Editor",
        "rank": "Alternate",
        "exportedType": {
          "identifier": "io.github.rekazer0.keyskin.sxi",
          "conformsTo": ["public.data"]
        }
      }
    ]
  }
}
